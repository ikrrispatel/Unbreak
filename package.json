{
  "name": "unbreak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/unit dist/tests/integration/mock-run.test.js",
    "test:live:observe": "npm run build && node --test dist/tests/integration/phoneuse-smoke.test.js",
    "test:live:open": "npm run build && node --test dist/tests/integration/phoneuse-open.test.js",
    "start": "node dist/app/server.js"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  },
  "dependencies": {
    "@phone-use/sdk": "0.6.0"
  }
}
